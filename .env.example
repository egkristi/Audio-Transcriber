# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# Hugging Face API Token (required for pyannote models)
# Get it from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional: OpenAI API Key (if using OpenAI Whisper API instead of local)
# OPENAI_API_KEY=your_openai_key_here

# Transcription Models
# Primary model for transcription (Norwegian-optimized)
PRIMARY_MODEL=NbAiLab/nb-whisper-large-verbatim

# Secondary model for comparison
SECONDARY_MODEL=openai/whisper-large-v3

# Processing Configuration
# Number of parallel workers for batch processing
MAX_WORKERS=4

# Device configuration
# Options: cpu, cuda, mps (Metal Performance Shaders for Apple Silicon)
DEVICE=cpu

# Compute type for faster-whisper
# Options: int8, float16, float32
COMPUTE_TYPE=int8

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json  # json or text

# Output Settings
OUTPUT_DIR=./output
LOG_DIR=./logs

# Database
DATABASE_PATH=./output/transcriptions.db

# Optional: Custom vocabulary file
# VOCABULARY_FILE=./vocabulary.json

# Optional: Domain for predefined vocabulary
# DOMAIN=medical  # Options: medical, legal, technical, finance
